{
  "name": "jsx-ai",
  "version": "0.3.0",
  "description": "Composable JSX frontend for provider-agnostic LLM prompts, tools, and agent history",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bench": "bun run bench/strategies.tsx",
    "example:game": "bun run examples/game-builder-agent.tsx"
  },
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "jsx",
    "ai",
    "llm",
    "tools",
    "function-calling",
    "agents",
    "gemini",
    "openai",
    "anthropic"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/7flash/jsx-ai"
  },
  "author": "7flash",
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "typescript": "^5.8.3",
    "@types/node": "^22.0.0"
  }
}
